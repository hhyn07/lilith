<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <%- include('includes/favicon') %>
    <base href="<%- serverURL %>/">
    <title>註冊 - Lilith</title>
    <%- include('includes/font-preload') %>
    <%- include('build/cover-pack-header') %>
    <script src="<%- serverURL %>/js/catppuccin.js?v=123"></script>
    <link rel="stylesheet" href="<%- serverURL %>/css/catppuccin.css?v=123">
</head>

<body class="lilith-login-page">
    <header class="login-topbar">
        <a class="login-brand" href="<%- serverURL %>/"><img class="ctp-brand-logo" src="<%- serverURL %>/icons/android-chrome-192x192.png" alt="" width="28" height="28">Lilith</a>
    </header>

    <main class="login-main">
        <h1 class="login-title">註冊</h1>

        <% if (errorMessage && errorMessage.length > 0) { %>
        <div class="login-alert login-alert-error" role="alert"><%= errorMessage %></div>
        <% } %>

        <form class="login-form" method="post" action="<%- serverURL %>/register" enctype="application/x-www-form-urlencoded">
            <label for="register-username">使用者名稱</label>
            <input type="text" class="form-control has-hint" id="register-username" name="username" value="<%= username %>" placeholder="您的使用者名稱" autocomplete="username" required autofocus
                maxlength="<%= rules.USERNAME_MAX_LENGTH %>" pattern="[A-Za-z0-9][A-Za-z0-9\-]*" aria-describedby="register-username-hint">
            <p class="login-hint" id="register-username-hint"><%= rules.USERNAME_HINT %></p>

            <label for="register-email">Email</label>
            <input type="email" class="form-control" id="register-email" name="email" value="<%= email %>" placeholder="您的 Email" autocomplete="email" required>

            <label for="register-password">密碼</label>
            <input type="password" class="form-control has-hint" id="register-password" name="password" placeholder="您的密碼" autocomplete="new-password" required
                minlength="<%= rules.PASSWORD_MIN_LENGTH %>" maxlength="<%= rules.PASSWORD_MAX_LENGTH %>" aria-describedby="register-password-hint">
            <p class="login-hint" id="register-password-hint"><%= rules.PASSWORD_HINT %>。</p>

            <label for="register-password-confirm">確認密碼</label>
            <input type="password" class="form-control" id="register-password-confirm" name="password_confirm" placeholder="再輸入一次密碼" autocomplete="new-password" required>

            <button type="submit" class="btn btn-primary login-submit">註冊</button>
        </form>

        <% if (oauthProviders.length > 0) { %>
        <div class="login-divider"><span>或是</span></div>
        <div class="login-providers">
            <% oauthProviders.forEach(function (p) { %>
            <a class="login-provider" href="<%- serverURL %>/auth/<%= p.id %>">
                <i class="fa <%= p.icon %> fa-fw"></i>
                <span>透過 <%= p.name %> 登入</span>
            </a>
            <% }) %>
        </div>
        <% } %>

        <p class="login-other">已經有帳號了？<a href="<%- serverURL %>/login">登入</a></p>
        <% if (termsOfUse) { %>
        <p class="login-terms">註冊即表示您同意<a href="<%- serverURL %>/s/terms-of-use" target="_blank" rel="noopener">服務條款</a>。</p>
        <% } %>
    </main>
</body>

</html>
